{"id":"caffeine-real-graph","tool":"chem_analyze_molecule","arguments":{"smiles":"Cn1cnc2c1c(=O)n(C)c(=O)n2C"},"assertions":[{"path":"data.formula","op":"equals","value":"C8H10N4O2"},{"path":"data.atoms","op":"length","value":14},{"path":"data.bonds","op":"length","value":15}],"expects_artifact":true}
{"id":"aspirin-descriptors","tool":"chem_analyze_molecule","arguments":{"smiles":"CC(=O)OC1=CC=CC=C1C(=O)O"},"assertions":[{"path":"data.properties.HBD","op":"equals","value":"1"},{"path":"data.properties.HBA","op":"equals","value":"3"},{"path":"data.properties.Rings","op":"equals","value":"1"}],"expects_artifact":true}
{"id":"protein-fasta-cleaning","tool":"protein_analyze_sequence","arguments":{"sequence":">trpcage\nNLYIQWLKDGGPSSGRPPPS\n"},"assertions":[{"path":"data.sequence","op":"equals","value":"NLYIQWLKDGGPSSGRPPPS"},{"path":"data.properties.Length","op":"equals","value":"20 aa"}],"expects_artifact":true}
{"id":"pairwise-alignment","tool":"sequence_align","arguments":{"sequence_a":"ACDEFG","sequence_b":"ACDFFG"},"assertions":[{"path":"data.identity","op":"approx","value":83.33,"tolerance":0.01},{"path":"data.alignmentLength","op":"equals","value":6}],"expects_artifact":true}
{"id":"property-chart-artifact","tool":"visualization_property_chart","arguments":{"title":"Lead comparison","properties":{"MW":194.19,"TPSA":61.8}},"assertions":[{"path":"artifacts.0.type","op":"equals","value":"bar-chart"},{"path":"artifacts.0.data.values","op":"length","value":2}],"expects_artifact":true}
{"id":"protein-hydropathy-track","tool":"visualization_sequence_track","arguments":{"sequence":"NLYIQWLKDGGPSSGRPPPS"},"assertions":[{"path":"artifacts.0.type","op":"equals","value":"sequence-track"},{"path":"artifacts.0.data.values","op":"length","value":20}],"expects_artifact":true}
{"id":"research-routing","tool":"research_route","arguments":{"question":"比对两个蛋白序列并画出疏水性差异"},"assertions":[{"path":"lanes","op":"contains","value":"protein structure and sequence"},{"path":"lanes","op":"contains","value":"sequence comparison"}]}
{"id":"workspace-boundary","tool":"workspace_read_text","arguments":{"path":"../README.md"},"expected_error":"inside the Molemo workspace"}
{"id":"pdb-coordinate-artifact","tool":"structure_parse_workspace","arguments":{"path":"examples/mini-protein.pdb"},"assertions":[{"path":"data.structure.atom_count","op":"equals","value":10},{"path":"data.structure.sequence","op":"equals","value":"AG"},{"path":"artifacts.0.type","op":"equals","value":"protein-structure"}],"expects_artifact":true}
{"id":"fastq-quality-control","tool":"ngs_fastq_qc","arguments":{"path":"examples/tiny.fastq"},"assertions":[{"path":"data.reads_analyzed","op":"equals","value":3},{"path":"data.mean_quality","op":"equals","value":20.0},{"path":"data.q30_percent","op":"approx","value":33.33,"tolerance":0.01},{"path":"artifacts.0.type","op":"equals","value":"fastq-qc"}],"expects_artifact":true}
{"id":"public-database-routing","tool":"research_route","arguments":{"question":"从 PubChem 查化合物，再从 UniProt 和 RCSB 检查蛋白结构"},"assertions":[{"path":"suggested_tools","op":"contains","value":"database_lookup_pubchem"},{"path":"suggested_tools","op":"contains","value":"database_lookup_uniprot"},{"path":"suggested_tools","op":"contains","value":"structure_fetch_pdb"}]}
{"id":"workflow-requires-approval","tool":"workflow_create_plan","arguments":{"template_id":"molecule-profile","inputs":{"smiles":"CCO"},"objective":"Review ethanol"},"assertions":[{"path":"data.status","op":"equals","value":"pending_approval"},{"path":"data.trace","op":"length","value":0},{"path":"artifacts.0.type","op":"equals","value":"workflow-plan"}],"expects_artifact":true}
